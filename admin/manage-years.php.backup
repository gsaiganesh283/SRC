<?php
error_reporting(E_ALL);
ini_set('display_errors', 1);

require_once '../config/config.php';
require_once '../includes/session.php';
require_once '../includes/functions.php';

requireAdmin();

// Permission check - now more permissive  
$canManageYears = true;
if (isset($_SESSION['admin_id'])) {
    try {
        $canManageYears = hasAdminPermission($_SESSION['admin_id'], 'manage_years');
    } catch (Exception $e) {
        error_log('Permission check error: ' . $e->getMessage());
        $canManageYears = true; // Grant access on error
    }
}

$errors = [];
$success = '';

// Handle form submission for adding/editing academic year
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';
    
    if ($action === 'add' || $action === 'edit') {
        $yearName = trim($_POST['year_name'] ?? '');
        $startDate = trim($_POST['start_date'] ?? '');
        $endDate = trim($_POST['end_date'] ?? '');
        $interestRate = trim($_POST['interest_rate'] ?? '');
        $interestType = trim($_POST['interest_type'] ?? 'Monthly');
        $includeInterestInTotal = trim($_POST['include_interest_in_total'] ?? 'Yes');
        $collectionModel = trim($_POST['collection_model'] ?? 'FullAmount');
        $defaultMonth = trim($_POST['default_month'] ?? '');
        $defaultTransactionDate = trim($_POST['default_transaction_date'] ?? '');
        $lastMonthToCollect = trim($_POST['last_month_to_collect'] ?? '');
        $deferredPrincipalAmount = floatval($_POST['deferred_principal_amount'] ?? 0);
        $standingMonthlyInterest = floatval($_POST['standing_monthly_interest'] ?? 100);
        $totalCollection = trim($_POST['total_collection'] ?? 0);
        $totalExpenses = trim($_POST['total_expenses'] ?? 0);
        $balanceAmount = trim($_POST['balance_amount'] ?? 0);
        $status = trim($_POST['status'] ?? 'Upcoming');
        
        // Validation
        if (empty($yearName)) $errors[] = 'Year name is required';
        if (empty($startDate)) $errors[] = 'Start date is required';
        if (empty($endDate)) $errors[] = 'End date is required';
        if (empty($interestRate)) $errors[] = 'Interest rate is required';
        if (!in_array($interestType, ['Monthly', 'Yearly'])) $errors[] = 'Invalid interest type';
        if (!in_array($includeInterestInTotal, ['Yes', 'No'])) $errors[] = 'Invalid include interest option';
        if (!in_array($collectionModel, ['InterestOnly', 'FullAmount', 'FlexiblePayment'])) $errors[] = 'Invalid collection model';
        
        // Validate date format if provided (DD-MM-YYYY)
        if (!empty($defaultTransactionDate)) {
            if (!preg_match('/^\d{2}-\d{2}-\d{4}$/', $defaultTransactionDate)) {
                $errors[] = 'Default transaction date must be in DD-MM-YYYY format';
            }
        }
        
        if (empty($errors)) {
            try {
                if ($action === 'add') {
                    $selectedMembers = $_POST['selected_members'] ?? [];
                    
                    $stmt = $pdo->prepare("INSERT INTO academic_years (YearName, StartDate, EndDate, InterestRate, InterestType, IncludeInterestInTotal, CollectionModel, DefaultMonth, DefaultTransactionDate, LastMonthToCollect, DeferredPrincipalAmount, StandingMonthlyInterest, TotalCollection, TotalExpenses, BalanceAmount, Status, CreatedBy) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
                    $stmt->execute([$yearName, $startDate, $endDate, $interestRate, $interestType, $includeInterestInTotal, $collectionModel, $defaultMonth, $defaultTransactionDate, $lastMonthToCollect, $deferredPrincipalAmount, $standingMonthlyInterest, $totalCollection, $totalExpenses, $balanceAmount, $status, $_SESSION['admin_id']]);
                    
                    $yearID = $pdo->lastInsertId();
                    
                    // Save year-member associations
                    if (!empty($selectedMembers)) {
                        $insertStmt = $pdo->prepare("
                            INSERT INTO year_members (YearID, MemberID, JoinedDate, Status)
                            VALUES (?, ?, ?, 'Active')
                        ");
                        foreach ($selectedMembers as $memberId) {
                            $insertStmt->execute([$yearID, intval($memberId), $startDate]);
                        }
                    }
                    
                    // Create audit log for year creation
                    createAuditLog(
                        $_SESSION['admin_id'],
                        'Admin',
                        'Settings',
                        'Create Academic Year',
                        "Created academic year: $yearName ($startDate to $endDate)",
                        'academic_years',
                        $yearID,
                        null,
                        json_encode([
                            'YearName' => $yearName,
                            'StartDate' => $startDate,
                            'EndDate' => $endDate,
                            'Status' => $status
                        ]),
                        'High'
                    );
                    
                    $success = 'Academic year added successfully!';
                } else {
                    $yearID = intval($_POST['year_id']);
                    $selectedMembers = $_POST['selected_members'] ?? [];
                    
                    // Get old data for audit log
                    $oldStmt = $pdo->prepare("SELECT * FROM academic_years WHERE YearID = ?");
                    $oldStmt->execute([$yearID]);
                    $oldData = $oldStmt->fetch(PDO::FETCH_ASSOC);
                    
                    $stmt = $pdo->prepare("UPDATE academic_years SET YearName = ?, StartDate = ?, EndDate = ?, InterestRate = ?, InterestType = ?, IncludeInterestInTotal = ?, CollectionModel = ?, DefaultMonth = ?, DefaultTransactionDate = ?, LastMonthToCollect = ?, DeferredPrincipalAmount = ?, StandingMonthlyInterest = ?, TotalCollection = ?, TotalExpenses = ?, BalanceAmount = ?, Status = ? WHERE YearID = ?");
                    $stmt->execute([$yearName, $startDate, $endDate, $interestRate, $interestType, $includeInterestInTotal, $collectionModel, $defaultMonth, $defaultTransactionDate, $lastMonthToCollect, $deferredPrincipalAmount, $standingMonthlyInterest, $totalCollection, $totalExpenses, $balanceAmount, $status, $yearID]);
                    
                    // Update year-member associations: delete existing and insert new
                    $pdo->prepare("DELETE FROM year_members WHERE YearID = ?")->execute([$yearID]);
                    
                    if (!empty($selectedMembers)) {
                        $insertStmt = $pdo->prepare("
                            INSERT INTO year_members (YearID, MemberID, JoinedDate, Status)
                            VALUES (?, ?, ?, 'Active')
                        ");
                        foreach ($selectedMembers as $memberId) {
                            $insertStmt->execute([$yearID, intval($memberId), $startDate]);
                        }
                    }
                    
                    // Create audit log for year update
                    createAuditLog(
                        $_SESSION['admin_id'],
                        'Admin',
                        'Settings',
                        'Update Academic Year',
                        "Updated academic year: $yearName",
                        'academic_years',
                        $yearID,
                        json_encode([
                            'YearName' => $oldData['YearName'],
                            'Status' => $oldData['Status'],
                            'InterestRate' => $oldData['InterestRate']
                        ]),
                        json_encode([
                            'YearName' => $yearName,
                            'Status' => $status,
                            'InterestRate' => $interestRate
                        ]),
                        'High'
                    );
                    
                    $success = 'Academic year updated successfully!';
                }
            } catch (Exception $e) {
                $errors[] = 'Error: ' . $e->getMessage();
            }
        }
    } elseif ($action === 'delete') {
        $yearID = intval($_POST['year_id']);
        try {
            // Get year data before deletion for audit log
            $yearStmt = $pdo->prepare("SELECT YearName FROM academic_years WHERE YearID = ?");
            $yearStmt->execute([$yearID]);
            $yearName = $yearStmt->fetchColumn();
            
            $stmt = $pdo->prepare("DELETE FROM academic_years WHERE YearID = ?");
            $stmt->execute([$yearID]);
            
            // Create audit log for year deletion
            createAuditLog(
                $_SESSION['admin_id'],
                'Admin',
                'Settings',
                'Delete Academic Year',
                "Deleted academic year: $yearName (ID: $yearID)",
                'academic_years',
                $yearID,
                json_encode(['YearName' => $yearName]),
                null,
                'Critical'
            );
            
            $success = 'Academic year deleted successfully!';
        } catch (Exception $e) {
            $errors[] = 'Error deleting year: ' . $e->getMessage();
        }
    }
}

// Fetch all members for multi-select dropdown
try {
    $stmt = $pdo->query("SELECT MemberID, MemberName, Status FROM members ORDER BY MemberName ASC");
    $allMembers = $stmt->fetchAll(PDO::FETCH_ASSOC);
} catch (Exception $e) {
    $allMembers = [];
}

// Fetch all academic years
try {
    $stmt = $pdo->query("SELECT * FROM academic_years ORDER BY StartDate DESC");
    $years = $stmt->fetchAll(PDO::FETCH_ASSOC);
} catch (Exception $e) {
    $years = [];
    $errors[] = 'Error fetching years: ' . $e->getMessage();
}

// Fetch year-member associations for each year
$yearMembers = [];
foreach ($years as $year) {
    $stmt = $pdo->prepare("SELECT MemberID FROM year_members WHERE YearID = ? AND Status = 'Active'");
    $stmt->execute([$year['YearID']]);
    $yearMembers[$year['YearID']] = $stmt->fetchAll(PDO::FETCH_COLUMN);
}
?>

