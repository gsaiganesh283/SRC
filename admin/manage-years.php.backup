                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Interest Rate <span class="required">*</span></label>
                        <input type="number" name="interest_rate" id="interestRate" class="form-input" step="0.01" placeholder="e.g., 0.20 for 20%" required>
                        <small style="color: #666; font-size: 12px;">Enter as decimal (e.g., 0.20 = 20%, 0.15 = 15%)</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Interest Type <span class="required">*</span></label>
                        <select name="interest_type" id="interestType" class="form-select" required>
                            <option value="Monthly">Monthly Interest</option>
                            <option value="Yearly">Yearly Interest</option>
                        </select>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Include Interest in Total? <span class="required">*</span></label>
                        <select name="include_interest_in_total" id="includeInterestInTotal" class="form-select" required>
                            <option value="Yes">Yes - Add interest to distributed amount</option>
                            <option value="No">No - Interest separate from distributed amount</option>
                        </select>
                        <small style="color: #666; font-size: 12px;">
                            <strong>Yes:</strong> Total = Distribution + Interest (e.g., ₹500 + ₹100 = ₹600)<br>
                            <strong>No:</strong> Total = Distribution only (e.g., ₹500, Interest ₹100 shown separately)
                        </small>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Collection Model <span class="required">*</span></label>
                        <select name="collection_model" id="collectionModel" class="form-select" required onchange="updateCollectionModelInfo()">
                            <option value="FullAmount">Full Amount - Pay everything each month</option>
                            <option value="InterestOnly">Interest Only - Pay interest monthly, principal on new distribution</option>
                            <option value="FlexiblePayment">Flexible Payment - Choose amount each month</option>
                        </select>
                        <div id="collectionModelInfo" style="margin-top: 10px; padding: 12px; background: #f0f7ff; border-left: 4px solid #667eea; border-radius: 4px; display: none;">
                            <small style="color: #333; font-size: 12px; line-height: 1.6;"></small>
                        </div>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Default Transaction Month</label>
                        <select name="default_month" id="defaultMonth" class="form-select">
                            <option value="">-- Use System Month --</option>
                            <option value="January">January</option>
                            <option value="February">February</option>
                            <option value="March">March</option>
                            <option value="April">April</option>
                            <option value="May">May</option>
                            <option value="June">June</option>
                            <option value="July">July</option>
                            <option value="August">August</option>
                            <option value="September">September</option>
                            <option value="October">October</option>
                            <option value="November">November</option>
                            <option value="December">December</option>
                        </select>
                        <small style="color: #666; font-size: 12px;">Leave empty to use current system month</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Default Transaction Date</label>
                        <input type="text" name="default_transaction_date" id="defaultTransactionDate" class="form-input" placeholder="DD-MM-YYYY (e.g., 01-10-2024)" pattern="\d{2}-\d{2}-\d{4}" maxlength="10">
                        <small style="color: #666; font-size: 12px;">Date for transactions in DD-MM-YYYY format (e.g., 01-10-2024). Leave empty to use system date.</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Last Month to Collect Principal</label>
                        <select name="last_month_to_collect" id="lastMonthToCollect" class="form-select">
                            <option value="">Not Set</option>
                            <option value="January">January</option>
                            <option value="February">February</option>
                            <option value="March">March</option>
                            <option value="April">April</option>
                            <option value="May">May</option>
                            <option value="June">June</option>
                            <option value="July">July</option>
                            <option value="August">August</option>
                            <option value="September">September</option>
                            <option value="October">October</option>
                            <option value="November">November</option>
                            <option value="December">December</option>
                        </select>
                        <small style="color: #666; font-size: 12px;">Month when deferred principal should be collected</small>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Deferred Principal Amount</label>
                        <input type="number" name="deferred_principal_amount" id="deferredPrincipalAmount" class="form-input" step="0.01" min="0" placeholder="0.00">
                        <small style="color: #666; font-size: 12px;">Principal amount deferred to last month (e.g., 410.00)</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Standing Monthly Interest</label>
                        <input type="number" name="standing_monthly_interest" id="standingMonthlyInterest" class="form-input" step="0.01" min="0" value="100" placeholder="100.00">
                        <small style="color: #666; font-size: 12px;">Fixed monthly interest amount (default: 100.00)</small>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Status <span class="required">*</span></label>
                        <select name="status" id="status" class="form-select" required>
                            <option value="Upcoming">Upcoming</option>
                            <option value="Active">Active</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <!-- Empty for grid alignment -->
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Total Collection (₹)</label>
                    <input type="number" name="total_collection" id="totalCollection" class="form-input" step="0.01" value="0.00">
                </div>
                
                <div class="form-group">
                    <label class="form-label">Total Expenses (₹)</label>
                    <input type="number" name="total_expenses" id="totalExpenses" class="form-input" step="0.01" value="0.00">
                </div>
                
                <div class="form-group">
                    <label class="form-label">Balance Amount (₹)</label>
                    <input type="number" name="balance_amount" id="balanceAmount" class="form-input" step="0.01" value="0.00">
                </div>
                
                <div class="form-group">
                    <label class="form-label">Select Members for this Academic Year</label>
                    <div style="border: 1px solid #d1d5db; border-radius: 8px; padding: 10px; max-height: 300px; overflow-y: auto; background: #f9fafb;">
                        <div style="margin-bottom: 10px; padding: 8px; background: white; border-radius: 6px; position: sticky; top: 0; z-index: 10;">
                            <input type="text" id="memberSearch" placeholder="Search members..." style="width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;">
                        </div>
                        <div style="display: flex; gap: 10px; margin-bottom: 10px; position: sticky; top: 50px; background: #f9fafb; padding: 5px 0; z-index: 9;">
                            <button type="button" onclick="selectAllMembers()" class="btn btn-success btn-sm" style="padding: 6px 12px; font-size: 12px;">
                                <i class="fas fa-check-double"></i> Select All
                            </button>
                            <button type="button" onclick="deselectAllMembers()" class="btn btn-danger btn-sm" style="padding: 6px 12px; font-size: 12px;">
                                <i class="fas fa-times"></i> Deselect All
                            </button>
                            <span id="selectedCount" style="padding: 6px 12px; background: #667eea; color: white; border-radius: 6px; font-size: 12px; font-weight: 600;">0 selected</span>
                        </div>
                        <div id="memberCheckboxes">
                            <?php foreach ($allMembers as $member): ?>
                            <label style="display: flex; align-items: center; padding: 8px; margin-bottom: 5px; background: white; border-radius: 6px; cursor: pointer; transition: background 0.2s;" 
                                   onmouseover="this.style.background='#e0e7ff'" onmouseout="this.style.background='white'" 
                                   class="member-checkbox-label" data-member-name="<?php echo strtolower(htmlspecialchars($member['MemberName'])); ?>">
                                <input type="checkbox" name="selected_members[]" value="<?php echo $member['MemberID']; ?>" 
                                       style="margin-right: 10px; width: 18px; height: 18px; cursor: pointer;" 
                                       onchange="updateSelectedCount()">
                                <span style="flex: 1; font-weight: 500;"><?php echo htmlspecialchars($member['MemberName']); ?></span>
                                <span style="font-size: 12px; color: #6b7280; padding: 2px 8px; background: #<?php echo $member['Status'] === 'Active' ? 'd1fae5' : 'fee2e2'; ?>; border-radius: 4px;">
                                    <?php echo $member['Status']; ?>
                                </span>
                            </label>
                            <?php endforeach; ?>
                        </div>
                    </div>
                </div>
                
                <div class="form-actions">
                    <button type="button" onclick="closeModal()" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> <span id="submitText">Save Year</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Form (hidden) -->
    <form id="deleteForm" method="POST" style="display: none;">
        <input type="hidden" name="action" value="delete">
        <input type="hidden" name="year_id" id="deleteYearID">
    </form>

    <script>
        const yearMembersData = <?php echo json_encode($yearMembers); ?>;
        
        function openAddModal() {
            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-plus-circle"></i> Add Academic Year';
            document.getElementById('formAction').value = 'add';
            document.getElementById('submitText').textContent = 'Save Year';
            document.getElementById('yearForm').reset();
            updateSelectedCount();
            document.getElementById('yearModal').classList.add('active');
        }

        function editYear(year) {
            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-edit"></i> Edit Academic Year';
            document.getElementById('formAction').value = 'edit';
            document.getElementById('submitText').textContent = 'Update Year';
            document.getElementById('yearID').value = year.YearID;
            document.getElementById('yearName').value = year.YearName;
            document.getElementById('startDate').value = year.StartDate;
            document.getElementById('endDate').value = year.EndDate;
            document.getElementById('interestRate').value = year.InterestRate;
            document.getElementById('interestType').value = year.InterestType || 'Monthly';
            document.getElementById('includeInterestInTotal').value = year.IncludeInterestInTotal || 'Yes';
            document.getElementById('collectionModel').value = year.CollectionModel || 'FullAmount';
            document.getElementById('defaultMonth').value = year.DefaultMonth || '';
            document.getElementById('defaultTransactionDate').value = year.DefaultTransactionDate || '';
            document.getElementById('lastMonthToCollect').value = year.LastMonthToCollect || '';
            document.getElementById('deferredPrincipalAmount').value = year.DeferredPrincipalAmount || '0';
            document.getElementById('standingMonthlyInterest').value = year.StandingMonthlyInterest || '100';
            updateCollectionModelInfo(); // Update the info text
            document.getElementById('status').value = year.Status;
            document.getElementById('totalCollection').value = year.TotalCollection;
            document.getElementById('totalExpenses').value = year.TotalExpenses;
            document.getElementById('balanceAmount').value = year.BalanceAmount;
            
            // Pre-select members for this year
            const checkboxes = document.querySelectorAll('input[name="selected_members[]"]');
            const selectedMembers = yearMembersData[year.YearID] || [];
            checkboxes.forEach(cb => {
                cb.checked = selectedMembers.includes(parseInt(cb.value));
            });
            
            updateSelectedCount();
            document.getElementById('yearModal').classList.add('active');
        }
        
        function selectAllMembers() {
            const checkboxes = document.querySelectorAll('input[name="selected_members[]"]');
            const visibleLabels = Array.from(document.querySelectorAll('.member-checkbox-label'))
                .filter(label => label.style.display !== 'none');
            
            visibleLabels.forEach(label => {
                const checkbox = label.querySelector('input[type="checkbox"]');
                if (checkbox) checkbox.checked = true;
            });
            updateSelectedCount();
        }
        
        function deselectAllMembers() {
            const checkboxes = document.querySelectorAll('input[name="selected_members[]"]');
            checkboxes.forEach(cb => cb.checked = false);
            updateSelectedCount();
        }
        
        function updateSelectedCount() {
            const checkboxes = document.querySelectorAll('input[name="selected_members[]"]:checked');
            document.getElementById('selectedCount').textContent = checkboxes.length + ' selected';
        }
        
        // Member search functionality
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('memberSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    const searchTerm = e.target.value.toLowerCase();
                    const labels = document.querySelectorAll('.member-checkbox-label');
                    
                    labels.forEach(label => {
                        const memberName = label.getAttribute('data-member-name');
                        if (memberName.includes(searchTerm)) {
                            label.style.display = 'flex';
                        } else {
                            label.style.display = 'none';
                        }
                    });
                });
            }
        });

        function closeModal() {
            document.getElementById('yearModal').classList.remove('active');
        }

        function updateCollectionModelInfo() {
            const model = document.getElementById('collectionModel').value;
            const infoDiv = document.getElementById('collectionModelInfo');
            const infoText = infoDiv.querySelector('small');
            
            const modelInfo = {
                'InterestOnly': `
                    <strong style="color: #e65100;">📊 Interest Only Model</strong><br>
                    <strong>Month 1:</strong> Member receives ₹410 (principal)<br>
                    <strong>Month 2:</strong> Member pays ₹100 (interest only)<br>
                    <strong>Month 3:</strong> If member takes new ₹650, pays ₹100 + ₹650 + ₹150 = ₹900<br>
                    <strong>Month 4+:</strong> Member pays interest only (₹100 + ₹150 = ₹250)<br>
                    <em>Best for rotating savings/chit funds</em>
                `,
                'FullAmount': `
                    <strong style="color: #2e7d32;">💯 Full Amount Model</strong><br>
                    <strong>Month 1:</strong> Member receives ₹410<br>
                    <strong>Month 2:</strong> Member pays ₹410 + ₹100 = ₹510 (full payment)<br>
                    <strong>Balance:</strong> Closes to zero after full payment<br>
                    <em>Best for short-term loans</em>
                `,
                'FlexiblePayment': `
                    <strong style="color: #01579b;">🔄 Flexible Payment Model</strong><br>
                    Admin/Member chooses each month:<br>
                    • Pay interest only (minimum)<br>
                    • Pay partial amount<br>
                    • Pay full amount<br>
                    <em>Best for mixed groups with varying capabilities</em>
                `
            };
            
            infoText.innerHTML = modelInfo[model] || '';
            infoDiv.style.display = model ? 'block' : 'none';
        }

        function deleteYear(yearID, yearName) {
            if (confirm(`Are you sure you want to delete academic year "${yearName}"?\n\nThis will also delete all associated transactions!`)) {
                document.getElementById('deleteYearID').value = yearID;
                document.getElementById('deleteForm').submit();
            }
        }

        // Close modal when clicking outside
        document.getElementById('yearModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
        
        // Initialize collection model info on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateCollectionModelInfo();
        });
    </script>
</body>
</html>
