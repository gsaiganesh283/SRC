<?php
/**
 * Google Drive Helper - Upload & Manage Files on Google Drive
 * 
 * Supports two auth methods:
 * 1. Service Account (recommended for server-to-server)
 * 2. OAuth2 with refresh token
 * 
 * Files are uploaded to Google Drive and a shareable link is returned.
 */

class GoogleDriveHelper {
    private $pdo;
    private $settings;
    private $accessToken;
    
    const UPLOAD_URL = 'https://www.googleapis.com/upload/drive/v3/files';
    const FILES_URL = 'https://www.googleapis.com/drive/v3/files';
    const TOKEN_URL = 'https://oauth2.googleapis.com/token';
    
    public function __construct($pdo) {
        $this->pdo = $pdo;
        $this->loadSettings();
    }
    
    /**
     * Load Google Drive settings from database
     */
    private function loadSettings() {
        try {
            $stmt = $this->pdo->query("SELECT * FROM google_drive_settings WHERE IsActive = 1 ORDER BY SettingID DESC LIMIT 1");
            $this->settings = $stmt->fetch(PDO::FETCH_ASSOC);
        } catch (Exception $e) {
            $this->settings = null;
            error_log('GoogleDrive: Failed to load settings - ' . $e->getMessage());
        }
    }
    
    /**
     * Check if Google Drive integration is configured and active
     */
    public function isConfigured() {
        if (!$this->settings || !$this->settings['IsActive']) {
            return false;
        }
        
        if ($this->settings['AuthMethod'] === 'service_account') {
            return !empty($this->settings['ServiceAccountJSON']);
        }
        
        return !empty($this->settings['ClientID']) && !empty($this->settings['ClientSecret']) && !empty($this->settings['RefreshToken']);
    }
    
    /**
     * Get a valid access token (refreshing if needed)
     */
    private function getAccessToken() {
        if ($this->accessToken) {
            return $this->accessToken;
        }
        
        if (!$this->settings) {
            throw new Exception('Google Drive not configured');
        }
        
        if ($this->settings['AuthMethod'] === 'service_account') {
            return $this->getServiceAccountToken();
        }
        
        return $this->getOAuth2Token();
    }
    
    /**
     * Get access token using Service Account credentials
     */
    private function getServiceAccountToken() {
        $json = json_decode($this->settings['ServiceAccountJSON'], true);
        if (!$json || !isset($json['client_email']) || !isset($json['private_key'])) {
            throw new Exception('Invalid service account JSON');
        }
        
        // Create JWT header
        $header = base64_encode(json_encode(['alg' => 'RS256', 'typ' => 'JWT']));
        
        // Create JWT claim set
        $now = time();
        $claim = base64_encode(json_encode([
            'iss' => $json['client_email'],
            'scope' => 'https://www.googleapis.com/auth/drive.file',
            'aud' => self::TOKEN_URL,
            'exp' => $now + 3600,
            'iat' => $now,
        ]));
        
        // Create signature
        $toSign = $header . '.' . $claim;
        $privateKey = openssl_pkey_get_private($json['private_key']);
        if (!$privateKey) {
            throw new Exception('Invalid private key in service account JSON');
        }
        
        openssl_sign($toSign, $signature, $privateKey, 'sha256');
        $jwt = $toSign . '.' . base64_encode($signature);
        
        // Exchange JWT for access token
        $ch = curl_init(self::TOKEN_URL);
        curl_setopt_array($ch, [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => http_build_query([
                'grant_type' => 'urn:ietf:params:oauth:grant-type:jwt-bearer',
                'assertion' => $jwt,
            ]),
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTPHEADER => ['Content-Type: application/x-www-form-urlencoded'],
        ]);
        
        $response = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        
        if ($httpCode !== 200) {
            throw new Exception('Failed to get service account token: ' . $response);
        }
        
        $data = json_decode($response, true);
        $this->accessToken = $data['access_token'];
        
        // Cache the token
        $this->cacheToken($this->accessToken, $data['expires_in'] ?? 3600);
        
        return $this->accessToken;
    }
    
    /**
     * Get access token using OAuth2 refresh token
     */
    private function getOAuth2Token() {
        // Check if we have a valid cached token
        if (!empty($this->settings['AccessToken']) && !empty($this->settings['TokenExpiresAt'])) {
            $expiresAt = strtotime($this->settings['TokenExpiresAt']);
            if ($expiresAt > time() + 60) {
                $this->accessToken = $this->settings['AccessToken'];
                return $this->accessToken;
            }
        }
        
        // Refresh the token
        $ch = curl_init(self::TOKEN_URL);
        curl_setopt_array($ch, [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => http_build_query([
                'client_id' => $this->settings['ClientID'],
                'client_secret' => $this->settings['ClientSecret'],
                'refresh_token' => $this->settings['RefreshToken'],
                'grant_type' => 'refresh_token',
            ]),
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTPHEADER => ['Content-Type: application/x-www-form-urlencoded'],
        ]);
        
        $response = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        
        if ($httpCode !== 200) {
            throw new Exception('Failed to refresh Google token: ' . $response);
        }
        
        $data = json_decode($response, true);
        $this->accessToken = $data['access_token'];
        
        $this->cacheToken($this->accessToken, $data['expires_in'] ?? 3600);
        
        return $this->accessToken;
    }
    
    /**
     * Cache the access token in database
     */
    private function cacheToken($token, $expiresIn) {
        try {
            $expiresAt = date('Y-m-d H:i:s', time() + $expiresIn - 60);
            $stmt = $this->pdo->prepare("UPDATE google_drive_settings SET AccessToken = ?, TokenExpiresAt = ? WHERE SettingID = ?");
            $stmt->execute([$token, $expiresAt, $this->settings['SettingID']]);
        } catch (Exception $e) {
            error_log('GoogleDrive: Failed to cache token - ' . $e->getMessage());
        }
    }
    
    /**
     * Upload a file to Google Drive
     *
     * @param string $filePath Local file path
     * @param string $fileName Name for the file in Drive
     * @param string $mimeType MIME type of the file
     * @param string $folderType 'expenses' or 'events'
     * @return array {fileId, webViewLink, thumbnailLink, webContentLink}
     */
    public function uploadFile($filePath, $fileName, $mimeType, $folderType = 'expenses') {
        $token = $this->getAccessToken();
        
        // Determine target folder
        $parentFolderId = null;
        if ($folderType === 'expenses' && !empty($this->settings['ExpensesFolderID'])) {
            $parentFolderId = $this->settings['ExpensesFolderID'];
        } elseif ($folderType === 'events' && !empty($this->settings['EventsFolderID'])) {
            $parentFolderId = $this->settings['EventsFolderID'];
        } elseif (!empty($this->settings['FolderID'])) {
            $parentFolderId = $this->settings['FolderID'];
        }
        
        // Create file metadata
        $metadata = [
            'name' => $fileName,
            'description' => 'Proof attachment uploaded from SR Colony Management System',
        ];
        
        if ($parentFolderId) {
            $metadata['parents'] = [$parentFolderId];
        }
        
        // Multipart upload
        $boundary = 'proof_upload_boundary_' . uniqid();
        
        $fileContent = file_get_contents($filePath);
        if ($fileContent === false) {
            throw new Exception('Cannot read the file: ' . $filePath);
        }
        
        $body = "--{$boundary}\r\n";
        $body .= "Content-Type: application/json; charset=UTF-8\r\n\r\n";
        $body .= json_encode($metadata) . "\r\n";
        $body .= "--{$boundary}\r\n";
        $body .= "Content-Type: {$mimeType}\r\n";
        $body .= "Content-Transfer-Encoding: base64\r\n\r\n";
        $body .= base64_encode($fileContent) . "\r\n";
        $body .= "--{$boundary}--";
        
        $ch = curl_init(self::UPLOAD_URL . '?uploadType=multipart&fields=id,name,webViewLink,thumbnailLink,webContentLink,size');
        curl_setopt_array($ch, [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => $body,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTPHEADER => [
                "Authorization: Bearer {$token}",
                "Content-Type: multipart/related; boundary={$boundary}",
                'Content-Length: ' . strlen($body),
            ],
        ]);
        
        $response = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $curlError = curl_error($ch);
        curl_close($ch);
        
        if ($curlError) {
            throw new Exception('cURL error uploading to Google Drive: ' . $curlError);
        }
        
        if ($httpCode !== 200) {
            throw new Exception('Google Drive upload failed (HTTP ' . $httpCode . '): ' . $response);
        }
        
        $data = json_decode($response, true);
        
        // Make the file accessible via link
        $this->setFilePermission($data['id'], $token);
        
        return [
            'fileId' => $data['id'],
            'webViewLink' => $data['webViewLink'] ?? "https://drive.google.com/file/d/{$data['id']}/view",
            'thumbnailLink' => $data['thumbnailLink'] ?? null,
            'webContentLink' => $data['webContentLink'] ?? null,
            'size' => $data['size'] ?? filesize($filePath),
        ];
    }
    
    /**
     * Set file permission to "anyone with link can view"
     */
    private function setFilePermission($fileId, $token) {
        $ch = curl_init(self::FILES_URL . "/{$fileId}/permissions");
        curl_setopt_array($ch, [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => json_encode([
                'role' => 'reader',
                'type' => 'anyone',
            ]),
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTPHEADER => [
                "Authorization: Bearer {$token}",
                'Content-Type: application/json',
            ],
        ]);
        
        $response = curl_exec($ch);
        curl_close($ch);
        
        return $response;
    }
    
    /**
     * Delete a file from Google Drive
     */
    public function deleteFile($fileId) {
        $token = $this->getAccessToken();
        
        $ch = curl_init(self::FILES_URL . "/{$fileId}");
        curl_setopt_array($ch, [
            CURLOPT_CUSTOMREQUEST => 'DELETE',
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTPHEADER => [
                "Authorization: Bearer {$token}",
            ],
        ]);
        
        $response = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        
        return $httpCode === 204 || $httpCode === 200;
    }
    
    /**
     * Create a folder in Google Drive
     */
    public function createFolder($name, $parentFolderId = null) {
        $token = $this->getAccessToken();
        
        $metadata = [
            'name' => $name,
            'mimeType' => 'application/vnd.google-apps.folder',
        ];
        
        if ($parentFolderId) {
            $metadata['parents'] = [$parentFolderId];
        }
        
        $ch = curl_init(self::FILES_URL . '?fields=id,webViewLink');
        curl_setopt_array($ch, [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => json_encode($metadata),
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTPHEADER => [
                "Authorization: Bearer {$token}",
                'Content-Type: application/json',
            ],
        ]);
        
        $response = curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        
        if ($httpCode !== 200) {
            throw new Exception('Failed to create folder: ' . $response);
        }
        
        return json_decode($response, true);
    }
    
    /**
     * Get settings (for admin page display)
     */
    public function getSettings() {
        return $this->settings;
    }
    
    /**
     * Test the connection
     */
    public function testConnection() {
        try {
            $token = $this->getAccessToken();
            
            // Try to list files (just 1 to verify)
            $ch = curl_init(self::FILES_URL . '?pageSize=1&fields=files(id,name)');
            curl_setopt_array($ch, [
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_HTTPHEADER => [
                    "Authorization: Bearer {$token}",
                ],
            ]);
            
            $response = curl_exec($ch);
            $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            curl_close($ch);
            
            if ($httpCode === 200) {
                return ['success' => true, 'message' => 'Connected to Google Drive successfully'];
            }
            
            return ['success' => false, 'message' => 'Connection failed (HTTP ' . $httpCode . '): ' . $response];
        } catch (Exception $e) {
            return ['success' => false, 'message' => $e->getMessage()];
        }
    }
}

/**
 * ProofAttachmentManager - Handles file upload, storage (local + Google Drive), 
 * and management of proof attachments for expenses and events
 */
class ProofAttachmentManager {
    private $pdo;
    private $gdrive;
    private $localUploadDir;
    
    const MAX_FILE_SIZE = 10 * 1024 * 1024; // 10MB per file
    const MAX_FILES_PER_ENTITY = 5;
    
    const ALLOWED_TYPES = [
        'image/jpeg' => 'jpg',
        'image/png' => 'png',
        'image/gif' => 'gif',
        'image/webp' => 'webp',
        'application/pdf' => 'pdf',
        'application/msword' => 'doc',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document' => 'docx',
        'application/vnd.ms-excel' => 'xls',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' => 'xlsx',
        'text/csv' => 'csv',
        'text/plain' => 'txt',
    ];
    
    public function __construct($pdo) {
        $this->pdo = $pdo;
        $this->gdrive = new GoogleDriveHelper($pdo);
        $this->localUploadDir = dirname(dirname(__FILE__)) . '/uploads/proofs';
    }
    
    /**
     * Check if Google Drive is available for uploads
     */
    public function isGDriveEnabled() {
        return $this->gdrive->isConfigured();
    }
    
    /**
     * Upload proof files for an entity (expense or event_transaction)
     *
     * @param array $files $_FILES array for the proof_files input
     * @param string $entityType 'expense' or 'event_transaction'
     * @param int $entityId The ID of the expense or event transaction
     * @param int $uploadedBy User ID who uploaded
     * @return array Results with uploaded files info
     */
    public function uploadProofs($files, $entityType, $entityId, $uploadedBy) {
        $results = ['success' => [], 'errors' => []];
        
        // Check current attachment count
        $currentCount = $this->getAttachmentCount($entityType, $entityId);
        
        // Normalize files array (handle both single and multiple uploads)
        $normalizedFiles = $this->normalizeFiles($files);
        
        if (empty($normalizedFiles)) {
            return $results;
        }
        
        if ($currentCount + count($normalizedFiles) > self::MAX_FILES_PER_ENTITY) {
            $remaining = self::MAX_FILES_PER_ENTITY - $currentCount;
            $results['errors'][] = "Maximum " . self::MAX_FILES_PER_ENTITY . " files allowed. You can add {$remaining} more.";
            $normalizedFiles = array_slice($normalizedFiles, 0, $remaining);
        }
        
        $folderType = ($entityType === 'expense') ? 'expenses' : 'events';
        
        foreach ($normalizedFiles as $file) {
            try {
                // Validate file
                $this->validateFile($file);
                
                // Generate unique filename
                $ext = pathinfo($file['name'], PATHINFO_EXTENSION);
                $uniqueName = $entityType . '_' . $entityId . '_' . time() . '_' . uniqid() . '.' . strtolower($ext);
                
                // Save locally first
                $localDir = $this->localUploadDir . '/' . $folderType;
                if (!is_dir($localDir)) {
                    mkdir($localDir, 0755, true);
                }
                $localPath = $localDir . '/' . $uniqueName;
                
                if (!move_uploaded_file($file['tmp_name'], $localPath)) {
                    throw new Exception('Failed to save file locally');
                }
                
                // Try Google Drive upload
                $gdriveFileId = null;
                $gdriveUrl = null;
                $gdriveThumbnail = null;
                $uploadStatus = 'uploaded';
                $uploadError = null;
                
                if ($this->isGDriveEnabled()) {
                    try {
                        $gdriveResult = $this->gdrive->uploadFile($localPath, $uniqueName, $file['type'], $folderType);
                        $gdriveFileId = $gdriveResult['fileId'];
                        $gdriveUrl = $gdriveResult['webViewLink'];
                        $gdriveThumbnail = $gdriveResult['thumbnailLink'];
                        $uploadStatus = 'uploaded';
                    } catch (Exception $e) {
                        $uploadError = $e->getMessage();
                        $uploadStatus = 'failed';
                        error_log('GoogleDrive upload failed: ' . $e->getMessage());
                        // File is still saved locally, so we continue
                    }
                }
                
                // Save to database
                $stmt = $this->pdo->prepare("
                    INSERT INTO proof_attachments 
                    (EntityType, EntityID, FileName, OriginalName, MimeType, FileSize, 
                     GoogleDriveFileID, GoogleDriveURL, GoogleDriveThumbnail, LocalPath,
                     UploadStatus, UploadError, UploadedBy)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                ");
                $stmt->execute([
                    $entityType, $entityId, $uniqueName, $file['name'], $file['type'],
                    $file['size'], $gdriveFileId, $gdriveUrl, $gdriveThumbnail,
                    'uploads/proofs/' . $folderType . '/' . $uniqueName,
                    $uploadStatus, $uploadError, $uploadedBy
                ]);
                
                $attachmentId = $this->pdo->lastInsertId();
                
                // Update entity proof count
                $this->updateProofCount($entityType, $entityId);
                
                $results['success'][] = [
                    'attachmentId' => $attachmentId,
                    'originalName' => $file['name'],
                    'fileName' => $uniqueName,
                    'gdriveUrl' => $gdriveUrl,
                    'localPath' => 'uploads/proofs/' . $folderType . '/' . $uniqueName,
                    'uploadStatus' => $uploadStatus,
                    'size' => $file['size'],
                ];
                
            } catch (Exception $e) {
                $results['errors'][] = $file['name'] . ': ' . $e->getMessage();
            }
        }
        
        return $results;
    }
    
    /**
     * Validate a single file
     */
    private function validateFile($file) {
        if ($file['error'] !== UPLOAD_ERR_OK) {
            $errorMessages = [
                UPLOAD_ERR_INI_SIZE => 'File exceeds server upload limit',
                UPLOAD_ERR_FORM_SIZE => 'File exceeds form upload limit',
                UPLOAD_ERR_PARTIAL => 'File only partially uploaded',
                UPLOAD_ERR_NO_FILE => 'No file was uploaded',
                UPLOAD_ERR_NO_TMP_DIR => 'Missing temp folder',
                UPLOAD_ERR_CANT_WRITE => 'Failed to write file',
                UPLOAD_ERR_EXTENSION => 'Upload blocked by extension',
            ];
            throw new Exception($errorMessages[$file['error']] ?? 'Unknown upload error');
        }
        
        if ($file['size'] > self::MAX_FILE_SIZE) {
            throw new Exception('File size exceeds ' . (self::MAX_FILE_SIZE / 1024 / 1024) . 'MB limit');
        }
        
        if (!isset(self::ALLOWED_TYPES[$file['type']])) {
            $ext = strtolower(pathinfo($file['name'], PATHINFO_EXTENSION));
            $allowedExts = array_values(self::ALLOWED_TYPES);
            if (!in_array($ext, $allowedExts)) {
                throw new Exception('File type not allowed. Accepted: ' . implode(', ', array_unique($allowedExts)));
            }
        }
    }
    
    /**
     * Normalize $_FILES array for multiple file uploads
     */
    private function normalizeFiles($files) {
        $normalized = [];
        
        if (!isset($files['name'])) {
            return $normalized;
        }
        
        if (is_array($files['name'])) {
            for ($i = 0; $i < count($files['name']); $i++) {
                if ($files['error'][$i] === UPLOAD_ERR_NO_FILE) continue;
                $normalized[] = [
                    'name' => $files['name'][$i],
                    'type' => $files['type'][$i],
                    'tmp_name' => $files['tmp_name'][$i],
                    'error' => $files['error'][$i],
                    'size' => $files['size'][$i],
                ];
            }
        } else {
            if ($files['error'] !== UPLOAD_ERR_NO_FILE) {
                $normalized[] = $files;
            }
        }
        
        return $normalized;
    }
    
    /**
     * Get all proof attachments for an entity
     */
    public function getAttachments($entityType, $entityId) {
        $stmt = $this->pdo->prepare("
            SELECT * FROM proof_attachments 
            WHERE EntityType = ? AND EntityID = ? AND UploadStatus != 'deleted'
            ORDER BY UploadedAt ASC
        ");
        $stmt->execute([$entityType, $entityId]);
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
    
    /**
     * Get attachment count for an entity
     */
    public function getAttachmentCount($entityType, $entityId) {
        $stmt = $this->pdo->prepare("
            SELECT COUNT(*) FROM proof_attachments 
            WHERE EntityType = ? AND EntityID = ? AND UploadStatus != 'deleted'
        ");
        $stmt->execute([$entityType, $entityId]);
        return (int) $stmt->fetchColumn();
    }
    
    /**
     * Delete a proof attachment
     */
    public function deleteAttachment($attachmentId, $deletedBy = null) {
        $stmt = $this->pdo->prepare("SELECT * FROM proof_attachments WHERE AttachmentID = ?");
        $stmt->execute([$attachmentId]);
        $attachment = $stmt->fetch(PDO::FETCH_ASSOC);
        
        if (!$attachment) {
            throw new Exception('Attachment not found');
        }
        
        // Delete from Google Drive if it was uploaded
        if (!empty($attachment['GoogleDriveFileID']) && $this->isGDriveEnabled()) {
            try {
                $this->gdrive->deleteFile($attachment['GoogleDriveFileID']);
            } catch (Exception $e) {
                error_log('GoogleDrive delete failed: ' . $e->getMessage());
            }
        }
        
        // Delete local file
        if (!empty($attachment['LocalPath'])) {
            $fullPath = dirname(dirname(__FILE__)) . '/' . $attachment['LocalPath'];
            if (file_exists($fullPath)) {
                unlink($fullPath);
            }
        }
        
        // Mark as deleted in database
        $updateStmt = $this->pdo->prepare("
            UPDATE proof_attachments SET UploadStatus = 'deleted', DeletedAt = NOW() WHERE AttachmentID = ?
        ");
        $updateStmt->execute([$attachmentId]);
        
        // Update entity proof count
        $this->updateProofCount($attachment['EntityType'], $attachment['EntityID']);
        
        return true;
    }
    
    /**
     * Update the ProofCount column on the entity table
     */
    private function updateProofCount($entityType, $entityId) {
        $count = $this->getAttachmentCount($entityType, $entityId);
        
        if ($entityType === 'expense') {
            $stmt = $this->pdo->prepare("UPDATE expenses SET ProofCount = ? WHERE ExpenseID = ?");
            $stmt->execute([$count, $entityId]);
        } elseif ($entityType === 'event_transaction') {
            $stmt = $this->pdo->prepare("UPDATE event_transactions SET ProofCount = ? WHERE TransactionID = ?");
            $stmt->execute([$count, $entityId]);
        }
    }
    
    /**
     * Retry failed Google Drive uploads
     */
    public function retryFailedUploads() {
        $stmt = $this->pdo->query("SELECT * FROM proof_attachments WHERE UploadStatus = 'failed' AND LocalPath IS NOT NULL");
        $failed = $stmt->fetchAll(PDO::FETCH_ASSOC);
        
        $retried = 0;
        foreach ($failed as $attachment) {
            $fullPath = dirname(dirname(__FILE__)) . '/' . $attachment['LocalPath'];
            if (!file_exists($fullPath)) continue;
            
            $folderType = ($attachment['EntityType'] === 'expense') ? 'expenses' : 'events';
            
            try {
                $gdriveResult = $this->gdrive->uploadFile($fullPath, $attachment['FileName'], $attachment['MimeType'], $folderType);
                
                $updateStmt = $this->pdo->prepare("
                    UPDATE proof_attachments 
                    SET GoogleDriveFileID = ?, GoogleDriveURL = ?, GoogleDriveThumbnail = ?, 
                        UploadStatus = 'uploaded', UploadError = NULL
                    WHERE AttachmentID = ?
                ");
                $updateStmt->execute([
                    $gdriveResult['fileId'],
                    $gdriveResult['webViewLink'],
                    $gdriveResult['thumbnailLink'],
                    $attachment['AttachmentID']
                ]);
                
                $retried++;
            } catch (Exception $e) {
                error_log('Retry upload failed for attachment #' . $attachment['AttachmentID'] . ': ' . $e->getMessage());
            }
        }
        
        return $retried;
    }
    
    /**
     * Get file URL (Google Drive if available, otherwise local)
     */
    public function getFileUrl($attachment) {
        if (!empty($attachment['GoogleDriveURL'])) {
            return $attachment['GoogleDriveURL'];
        }
        
        if (!empty($attachment['LocalPath'])) {
            return '../../' . $attachment['LocalPath'];
        }
        
        return null;
    }
    
    /**
     * Get thumbnail URL for image files
     */
    public function getThumbnailUrl($attachment) {
        if (!empty($attachment['GoogleDriveThumbnail'])) {
            return $attachment['GoogleDriveThumbnail'];
        }
        
        // For local images, use the file itself as thumbnail
        if (strpos($attachment['MimeType'], 'image/') === 0 && !empty($attachment['LocalPath'])) {
            return '../../' . $attachment['LocalPath'];
        }
        
        return null;
    }
    
    /**
     * Get icon class for file type
     */
    public static function getFileIcon($mimeType) {
        $icons = [
            'image/jpeg' => 'fa-file-image',
            'image/png' => 'fa-file-image',
            'image/gif' => 'fa-file-image',
            'image/webp' => 'fa-file-image',
            'application/pdf' => 'fa-file-pdf',
            'application/msword' => 'fa-file-word',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document' => 'fa-file-word',
            'application/vnd.ms-excel' => 'fa-file-excel',
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' => 'fa-file-excel',
            'text/csv' => 'fa-file-csv',
            'text/plain' => 'fa-file-alt',
        ];
        
        return $icons[$mimeType] ?? 'fa-file';
    }
    
    /**
     * Format file size for display
     */
    public static function formatSize($bytes) {
        if ($bytes >= 1048576) return round($bytes / 1048576, 1) . ' MB';
        if ($bytes >= 1024) return round($bytes / 1024, 1) . ' KB';
        return $bytes . ' bytes';
    }
}
